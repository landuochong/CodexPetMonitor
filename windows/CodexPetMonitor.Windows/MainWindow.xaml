<Window x:Class="CodexPetMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Pet Monitor"
        Width="156" Height="174"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Width="144" Height="156"
               Margin="6"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,3,5">
            <Border Background="#E62EAD4A" CornerRadius="9" Height="18"
                    MinWidth="38" Margin="0,0,0,3" BorderBrush="#CCFFFFFF" BorderThickness="1">
                <TextBlock x:Name="RunningBadge" Text="▶ 0" Foreground="White"
                           FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="6,0" />
            </Border>
            <Border Background="#E6D92D20" CornerRadius="9" Height="18"
                    MinWidth="38" BorderBrush="#CCFFFFFF" BorderThickness="1">
                <TextBlock x:Name="WaitingBadge" Text="⌛ 0" Foreground="White"
                           FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="6,0" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
